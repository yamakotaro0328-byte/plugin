<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yamakotaro</groupId>
    <artifactId>ecoban-velocity</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>EcoBan-Velocity</name>
    <description>Network-wide ban/mute/kick enforcement for Velocity, sharing the same MySQL
        punishment data as the EcoBan Paper plugin on every backend server.</description>

    <!-- Independent Maven project (its own pom.xml), built in its own CI job. Depends on
         ecoban-core (a sibling module, installed to the local Maven repository first in CI -
         see build-ecoban-velocity in .github/workflows/build.yml) for all the platform-agnostic
         punishment logic, storage, migration, and the web dashboard; shaded into this module's
         own jar along with SnakeYAML (Velocity has no built-in config file API, unlike Bukkit's
         FileConfiguration) since neither is a proxy-provided API. -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>com.velocitypowered</groupId>
            <artifactId>velocity-api</artifactId>
            <version>3.3.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.yamakotaro</groupId>
            <artifactId>ecoban-core</artifactId>
            <version>1.0.0</version>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <defaultGoal>package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <!-- ecoban-core and its own dependencies (sqlite-jdbc, mysql-connector-j, gson), plus
                 SnakeYAML for config parsing, aren't proxy-provided, so they need to be bundled
                 into this plugin's jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
