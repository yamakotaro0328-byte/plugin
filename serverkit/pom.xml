<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.yamakotaro</groupId>
    <artifactId>serverkit</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>ServerKit</name>
    <description>Standalone, EcoTP-independent plugin: staff tools (vanish/freeze/staffchat), a friend
        system, and solo/team Ender Dragon arena fights. Each module can be toggled off in config.yml.</description>

    <!-- Independent Maven project (its own pom.xml), built in its own CI job so a build
         failure here never blocks or reflects on EcoTP or EcoTP-QuickActions. -->

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Paper 26.2's API is compiled for Java 25 (class file version 69); compiling
             against it with an older release flag rejects its class files outright. -->
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
        <repository>
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- Classic plugin.yml + CommandExecutor only (no Dialog API, no Brigadier), so this
             plugin runs on Spigot too, not just Paper. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>[26.2.build,)</version>
            <scope>provided</scope>
        </dependency>
        <!-- Vault is optional (the referral reward simply reports "no economy" without it);
             never shaded, so every plugin shares the same Economy class object. -->
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <defaultGoal>package</defaultGoal>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
